   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Golden Hour Matte</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Golden Hour Matte</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Golden Hour Matte</rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">User Presets</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Warm golden-hour film look with lifted matte shadows, saturated reds/oranges, muted blues, and olive-shifted greens. Modeled after a sunset Golden Gate Bridge reference.</rdf:li>
    </rdf:Alt>
   </crs:Description>
